# Python / Node build products
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
coverage/

# Credentials and local runtime data
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.db
*.db-*
*.sqlite*
*.log
/backend/data/
/backend/static/
/data/
/uploads/
/reports/

# Captures, binaries and local backups must never enter source history
*.pcap
*.pcapng
*.cap
*.pcap.gz
*.pcapng.gz
*.exe
*.dll
*.msi
*.zip
/_backups/
/测试包/
/tests/*
/tools/tshark/
/packaging/output/
/packaging/smoke-*/
/packaging/verification-*.txt
/opensource/
/_opensource_stage/

# Keep only reviewed public documentation
/docs/*
!/docs/kb/
!/docs/GETTING_STARTED.md
!/docs/RELEASING.md
!/docs/GITHUB_PUBLISH.md
!/docs/TESTING.md
/背景.md
/方案.md
/记忆.md
/进展.md
/progress.html
/gui_eval/
/start_gui_eval.bat

# Internal diagnostics can contain credentials or customer data
/tools/*
!/tools/verify_kb.py
!/tools/review_checks.py
!/tools/gen_synthetic.py
!/tools/check_public_source.py
!/tools/export_public_source.py
/backend/tests/probe*.py
/backend/tests/verify_findings.py
/frontend/scripts/smoke.cjs

# Editor / operating system
.idea/
.vscode/
Thumbs.db
.DS_Store
desktop.ini
